# NVIDIA Nemotron (build.nvidia.com, OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_EXTRACTION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# live = call API and record; replay = cache only (demo mode, offline)
LLM_MODE=live
LLM_CONCURRENCY=3
LLM_CACHE_DIR=

# Data harness: local | zetaris
DATA_BACKEND=local
DATA_DIR=
# empty = data/generated/dwp.sqlite; docker compose sets a Postgres URL
DWP_DB_URL=
# empty = in-process mock council API; e.g. http://localhost:8100
COUNCIL_API_URL=
ZETARIS_BASE_URL=
ZETARIS_API_TOKEN=

# Memory: sqlite | gaia
MEMORY_BACKEND=sqlite
MEMORY_DB=
GAIA_BASE_URL=
GAIA_API_KEY=

ASSESSMENT_DATE=2026-10-27
STALE_AFTER_DAYS=400
